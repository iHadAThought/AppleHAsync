<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Template only — prefer deploy/install-mac-agent.sh which writes a fully
  resolved plist pointing at ~/Applications/appleHAsync.app.
  Label / AssociatedBundleIdentifiers must stay app.ghostnetwork.appleHAsync
  so Login Items & Extensions show "appleHAsync".
-->
<dict>
  <key>Label</key>
  <string>app.ghostnetwork.appleHAsync</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>app.ghostnetwork.appleHAsync</string>
  </array>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/Shared/Applications/appleHAsync.app/Contents/MacOS/appleHAsync</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/Shared/appleHAsync</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/Shared/appleHAsync/logs/agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/appleHAsync/logs/agent.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>APPLE_HASYNC_ROOT</key>
    <string>/Users/Shared/appleHAsync</string>
    <key>PYTHONPATH</key>
    <string>/Users/Shared/appleHAsync</string>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
